{
  "name": "ict/ictech-product-review-with-real-uploaded-image-video",
  "description": "ICTech plugin",
  "type": "shopware-platform-plugin",
  "version": "2.0.0",
  "license": "proprietary",
  "autoload": {
    "psr-4": {
      "ICTECHProductReviewWithRealUploadedImageVideo\\": "src/"
    }
  },
  "require": {
    "shopware/core": "^6.7",
    "shopware/storefront": "^6.7",
    "shopware/administration": "^6.7"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "nunomaduro/phpinsights": "^2.13"
  },
  "extra": {
    "shopware-plugin-class": "ICTECHProductReviewWithRealUploadedImageVideo\\ICTECHProductReviewWithRealUploadedImageVideo",
    "label": {
      "de-DE": "Produktbewertung mit Echtbild und Video-Upload",
      "en-GB": "Product review with the real image and video upload"
    }
  },
  "config": {
    "allow-plugins": {
      "symfony/runtime": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
