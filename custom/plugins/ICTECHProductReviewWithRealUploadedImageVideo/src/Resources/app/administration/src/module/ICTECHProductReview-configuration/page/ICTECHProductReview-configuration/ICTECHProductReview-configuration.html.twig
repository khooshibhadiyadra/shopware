{% block productreview_configuration %}
    <sw-page class="productreview-configuration">
        {% block productreview_configuration_header %}
            <template #smart-bar-header>
                <h2>
                    {{ $tc('product-review-configuration.header') }} {{ $tc('sw-settings.index.title') }}
                </h2>
            </template>
        {% endblock %}

        {% block productreview_configuration_actions %}
            <template #smart-bar-actions>
                {% block productreview_configuration_actions_save %}
                    <sw-button-process v-model:value="isSaveSuccessful"
                                       class="sw-settings-login-registration__save-action"
                                       variant="primary"
                                       :isLoading="isLoading"
                                       :disabled="isLoading"
                                       @click="onSave">
                        {{ $tc('global.default.save') }}
                    </sw-button-process>
                {% endblock %}
            </template>
        {% endblock %}

        {% block productreview_configuration_content %}
            <template #content>
                {% block productreview_configuration_content_card %}
                    <sw-card-view>
                        {% block productreview_configuration_content_card_channel_config %}
                            <sw-sales-channel-config v-model:value="config"
                                                     ref="configComponent"
                                                     domain="ICTECHProductReviewWithRealUploadedImageVideo.config">

                                {% block productreview_configuration_content_card_channel_config_sales_channel %}
                                    <template #select="{ onInput, selectedSalesChannelId }">
                                        <sw-card positionIdentifier="" :title="$tc('global.entities.sales_channel', 2)">
                                            {% block biller_configuration_content_card_channel_config_sales_channel_card_title %}
                                                <sw-single-select v-model:value="selectedSalesChannelId"
                                                                  labelProperty="translated.name"
                                                                  valueProperty="id"
                                                                  :isLoading="isLoading"
                                                                  :options="salesChannels"
                                                                  @update:value="onInput">
                                                </sw-single-select>
                                            {% endblock %}
                                        </sw-card>
                                    </template>
                                {% endblock %}

                                {% block productreview_configuration_content_card_channel_config_cards %}
                                    <template #content="{ actualConfigData, allConfigs, selectedSalesChannelId }">
                                        <div v-if="actualConfigData">
                                            <sw-card :title="$tc('product-review-configuration.title')" positionIdentifier="">
                                                <sw-container>
                                                    <div class="switch-field">
                                                        <sw-inherit-wrapper
                                                                v-model:value="actualConfigData['ICTECHProductReviewWithRealUploadedImageVideo.config.pluginActive']"
                                                                :inheritedValue="selectedSalesChannelId === null ? null : allConfigs['null']['ICTECHProductReviewWithRealUploadedImageVideo.config.pluginActive']"
                                                                :customInheritationCheckFunction="checkBoolFieldInheritance">
                                                            <template #content="props">
                                                                <sw-switch-field
                                                                        name="ICTECHProductReviewWithRealUploadedImageVideo.config.pluginActive"
                                                                        :mapInheritance="props"
                                                                        :label="$tc('product-review-configuration.fields.pluginActive')"
                                                                        :helpText="$tc('product-review-configuration.fields.helpText.pluginActive')"
                                                                        :disabled="props.isInherited || !acl.can('ICTECHProductReviewWithRealUploadedImageVideo.editor')"
                                                                        :value="props.currentValue"
                                                                        @update:value="props.updateCurrentValue">
                                                                </sw-switch-field>
                                                            </template>
                                                        </sw-inherit-wrapper>
                                                    </div>
                                                    <div class="switch-field">
                                                        <sw-inherit-wrapper
                                                                v-model:value="actualConfigData['ICTECHProductReviewWithRealUploadedImageVideo.config.displayImageField']"
                                                                :inheritedValue="selectedSalesChannelId === null ? null : allConfigs['null']['ICTECHProductReviewWithRealUploadedImageVideo.config.displayImageField']"
                                                                :customInheritationCheckFunction="checkBoolFieldInheritance">
                                                            <template #content="props">
                                                                <sw-switch-field
                                                                        name="ICTECHProductReviewWithRealUploadedImageVideo.config.displayImageField"
                                                                        :mapInheritance="props"
                                                                        :label="$tc('product-review-configuration.fields.displayImageField')"
                                                                        :helpText="$tc('product-review-configuration.fields.helpText.displayImageField')"
                                                                        :disabled="props.isInherited || !acl.can('ICTECHProductReviewWithRealUploadedImageVideo.editor')"
                                                                        :value="props.currentValue"
                                                                        @update:value="props.updateCurrentValue">
                                                                </sw-switch-field>
                                                            </template>
                                                        </sw-inherit-wrapper>
                                                    </div>
                                                    <div v-if="actualConfigData['ICTECHProductReviewWithRealUploadedImageVideo.config.displayImageField']">
                                                        <div class="select-field">
                                                            <sw-inherit-wrapper
                                                                    v-model:value="actualConfigData['ICTECHProductReviewWithRealUploadedImageVideo.config.allowImageFileExtension']"
                                                                    :inheritedValue="selectedSalesChannelId == null ? null : allConfigs['null']['ICTECHProductReviewWithRealUploadedImageVideo.config.allowImageFileExtension']"
                                                                    :customInheritationCheckFunction="checkInheritance"
                                                                    :label="$tc('product-review-configuration.fields.allowImageFileExtension')">
                                                                <template #content="props">
                                                                    <sw-multi-select
                                                                            name="ICTECHProductReviewWithRealUploadedImageVideo.config.allowImageFileExtension"
                                                                            :options="imageFileExtentionOptions(imageFileExtentionParam)"
                                                                            labelProperty="name"
                                                                            valueProperty="id"
                                                                            :isInherited="props.isInherited"
                                                                            :value="props.currentValue"
                                                                            @update:value="props.updateCurrentValue"
                                                                            :disabled="props.isInherited || !acl.can('ICTECHProductReviewWithRealUploadedImageVideo.editor')">
                                                                    </sw-multi-select>
                                                                </template>
                                                            </sw-inherit-wrapper>
                                                        </div>
                                                        <div class="number-field">
                                                            <sw-inherit-wrapper
                                                                    v-model:value="actualConfigData['ICTECHProductReviewWithRealUploadedImageVideo.config.maximumFileSizeforImage']"
                                                                    :inheritedValue="selectedSalesChannelId == null ? null : allConfigs['null']['ICTECHProductReviewWithRealUploadedImageVideo.config.maximumFileSizeforImage']"
                                                                    :customInheritationCheckFunction="checkInheritance"
                                                                    :helpText="$tc('product-review-configuration.fields.helpText.maximumFileSizeforImage', 0, { maxUploadFileSize: maxUploadFileSize } )"
                                                                    :label="$tc('product-review-configuration.fields.maximumFileSizeforImage')">
                                                                <template #content="props">
                                                                    <sw-number-field
                                                                            name="ICTECHProductReviewWithRealUploadedImageVideo.config.maximumFileSizeforImage"
                                                                            numberType="int"
                                                                            :step="null"
                                                                            :min="1"
                                                                            :max="maxUploadFileSizeValue"
                                                                            :value="props.currentValue"
                                                                            @update:value="props.updateCurrentValue"
                                                                            :digits="5"
                                                                            :fillDigits="false"
                                                                            :allowEmpty="false"
                                                                            :disabled="props.isInherited || !acl.can('ICTECHProductReviewWithRealUploadedImageVideo.editor')">
                                                                    </sw-number-field>
                                                                </template>
                                                            </sw-inherit-wrapper>
                                                        </div>
                                                    </div>
                                                    <div class="select-field">
                                                        <sw-inherit-wrapper
                                                                v-model:value="actualConfigData['ICTECHProductReviewWithRealUploadedImageVideo.config.allowVideoFileExtension']"
                                                                :inheritedValue="selectedSalesChannelId == null ? null : allConfigs['null']['ICTECHProductReviewWithRealUploadedImageVideo.config.allowVideoFileExtension']"
                                                                :customInheritationCheckFunction="checkInheritance"
                                                                :label="$tc('product-review-configuration.fields.allowVideoFileExtension')">
                                                            <template #content="props">
                                                                <sw-multi-select
                                                                        name="ICTECHProductReviewWithRealUploadedImageVideo.config.allowVideoFileExtension"
                                                                        :options="videoFileExtentionOptions(videoFileExtentionParam)"
                                                                        labelProperty="name"
                                                                        valueProperty="id"
                                                                        :isInherited="props.isInherited"
                                                                        :value="props.currentValue"
                                                                        @update:value="props.updateCurrentValue"
                                                                        :disabled="props.isInherited || !acl.can('ICTECHProductReviewWithRealUploadedImageVideo.editor')">
                                                                </sw-multi-select>
                                                            </template>
                                                        </sw-inherit-wrapper>
                                                    </div>
                                                    <div class="number-field">
                                                        <sw-inherit-wrapper
                                                                v-model:value="actualConfigData['ICTECHProductReviewWithRealUploadedImageVideo.config.maximumFileSizeForVideo']"
                                                                :inheritedValue="selectedSalesChannelId == null ? null : allConfigs['null']['ICTECHProductReviewWithRealUploadedImageVideo.config.maximumFileSizeForVideo']"
                                                                :customInheritationCheckFunction="checkInheritance"
                                                                :helpText="$tc('product-review-configuration.fields.helpText.maximumFileSizeForVideo', 0, { maxUploadFileSize: maxUploadFileSize } )"
                                                                :label="$tc('product-review-configuration.fields.maximumFileSizeForVideo')">
                                                            <template #content="props">
                                                                <sw-number-field
                                                                        name="ICTECHProductReviewWithRealUploadedImageVideo.config.maximumFileSizeForVideo"
                                                                        numberType="int"
                                                                        :step="null"
                                                                        :min="1"
                                                                        :max="maxUploadFileSizeValue"
                                                                        :value="props.currentValue"
                                                                        @update:value="props.updateCurrentValue"
                                                                        :digits="5"
                                                                        :fillDigits="false"
                                                                        :allowEmpty="false"
                                                                        :disabled="props.isInherited || !acl.can('ICTECHProductReviewWithRealUploadedImageVideo.editor')">
                                                                </sw-number-field>

                                                            </template>
                                                        </sw-inherit-wrapper>
                                                    </div>
                                                </sw-container>
                                            </sw-card>
                                        </div>
                                    </template>
                                {% endblock %}
                            </sw-sales-channel-config>
                        {% endblock %}
                    </sw-card-view>
                {% endblock %}
            </template>
        {% endblock %}
    </sw-page>
{% endblock %}
