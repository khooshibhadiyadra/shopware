{% sw_extends '@Storefront/storefront/page/product-detail/review/review-item.html.twig' %}
{#{% sw_extends '@Storefront/storefront/component/review/review-item.html.twig' %}#}
{% block page_product_detail_review_item_info %}
<div class="row product-detail-review-item-info">
    {% block page_product_detail_review_item_info_alert %}
        {% if review.status == false %}
            <div class="col-12 product-detail-review-item-hint">
                {% sw_include '@Storefront/storefront/utilities/alert.html.twig' with {
                    type: "info",
                    content: "detail.reviewNotPublicYetAlert"|trans|sw_sanitize
                } %}
            </div>
        {% endif %}
    {% endblock %}

    {% block page_product_detail_review_item_info_date %}
        <div class="col-12 product-detail-review-item-date">
            <p><small>{{ review.createdAt|format_date('long') }} {{ review.createdAt|format_time('short') }}</small></p>
        </div>
    {% endblock %}

    {% block page_product_detail_review_item_info_points %}
        <div class="col-md-auto product-detail-review-item-points">
            {% sw_include '@Storefront/storefront/component/review/rating.html.twig' with {
                points: review.points
            } %}
        </div>
    {% endblock %}

    {% block page_product_detail_review_item_title %}
        <div class="col-md-auto product-detail-review-item-title">
            <p class="h5">
                {{ review.title|striptags|sw_sanitize }}
            </p>
        </div>
    {% endblock %}

    {% block page_product_detail_review_item_info_verify %}
        <div class="col product-detail-review-item-verify">
            {% if reviewVerifcation == 1 %}
                <a data-bs-toggle="tooltip"
                   data-placement="bottom"
                   title="{{ "detail.reviewVerifiedItemTooltip"|trans|striptags }}">
                    {% sw_icon 'checkmark-circle' style {
                        'color': 'primary',
                        'size': 'sm'
                    } %}
                </a>
            {% endif %}
        </div>
    {% endblock %}

    <div class="product-review-media">
        <!-- Image block -->
        {% block page_product_detail_review_item_image %}
        {% if  config('ICTECHProductReviewWithRealUploadedImageVideo.config.pluginActive') == true && config('ICTECHProductReviewWithRealUploadedImageVideo.config.displayImageField') == true %}
        {% if review.customFields.ICTECHImageVideoData %}
            {% if review.customFields.ICTECHImageVideoData.image %}
                {% set mediaImage = searchMedia([review.customFields.ICTECHImageVideoData.image], context.context) %}
                {% if mediaImage.elements is not empty %}
                    <div class="product-detail-review-item-image">
                        {# @var item \Shopware\Core\Content\Media\MediaEntity #}
                        {% for item in mediaImage %}
                            <img src="{{ item.url }}" height="50%" width="50%" data-bs-toggle="modal"
                                 data-bs-target="#imageModal-{{ review.id }}"/>
                        {% endfor %}
                    </div>
                {% endif %}
            {% endif %}
        {% endif %}
        {% endif %}
        {% endblock %}

        <!-- Video block -->
        {% block page_product_detail_review_item_video %}
            {% if  config('ICTECHProductReviewWithRealUploadedImageVideo.config.pluginActive') == true %}
                {% if review.customFields.ICTECHImageVideoData %}
                    {% if review.customFields.ICTECHImageVideoData.video %}
                        {% set mediaVideo = searchMedia([review.customFields.ICTECHImageVideoData.video], context.context) %}
                        {% if mediaVideo.elements is not empty %}
                            <div class="product-detail-review-item-video" data-bs-toggle="modal"
                             data-bs-target="#videoModal-{{ review.id }}">
                            
                                {# @var item \Shopware\Core\Content\Media\MediaEntity #}
                                {% for item in mediaVideo %}
                                    <video width="400" preload="metadata">
                                        <source src="{{ item.url }}#t=0.1" type="video/mp4">
                                    </video>
                                {% endfor %}
                            </div>
                        {% endif %}
                    {% endif %}
                {% endif %}
            {% endif %}
        {% endblock %}
    </div>
    <!-- Modal block -->
    {% block page_product_detail_review_item_image_video_modal %}
        {% if review.customFields.ICTECHImageVideoData %}
            {% if review.customFields.ICTECHImageVideoData.image %}
                <!-- Image Modal -->
                <div class="modal fade" id="imageModal-{{ review.id }}" tabindex="-1"
                     aria-labelledby="exampleModalLabel" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered modal-md review-media-modal">
                        <div class="modal-content">
                            <div class="modal-header">
                                <button type="button" class="btn-close" data-bs-dismiss="modal"
                                        aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                {% set mediaImage = searchMedia([review.customFields.ICTECHImageVideoData.image], context.context) %}

                                {% if mediaImage %}
                                    {# @var item \Shopware\Core\Content\Media\MediaEntity #}
                                    {% for item in mediaImage %}
                                        <img src="{{ item.url }}" height="50%" width="50%">
                                    {% endfor %}
                                {% endif %}

                            </div>
                            <div class="modal-footer">
                            </div>
                        </div>
                    </div>
                </div>
            {% endif %}
        {% endif %}
        <!-- Video Modal -->
        {% if review.customFields.ICTECHImageVideoData %}
            {% if review.customFields.ICTECHImageVideoData.video %}
                <div class="modal fade" id="videoModal-{{ review.id }}" tabindex="-1"
                     aria-labelledby="exampleModalLabel" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered modal-md  review-media-modal">
                        <div class="modal-content">
                            <div class="modal-header">
                                <button type="button" class="btn-close" data-bs-dismiss="modal"
                                        aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                {% set mediaVideo = searchMedia([review.customFields.ICTECHImageVideoData.video], context.context) %}
                                {% if mediaVideo %}
                                    {# @var item \Shopware\Core\Content\Media\MediaEntity #}
                                    {% for item in mediaVideo %}
                                        <video width="750" autoplay loop playsinline muted controls
                                               controlsList="nodownload nofullscreen noremoteplayback">
                                            <source src="{{ item.url }}#t=0.1" type="video/mp4">
                                        </video>
                                    {% endfor %}
                                {% endif %}
                            </div>
                            <div class="modal-footer">
                            </div>
                        </div>
                    </div>
                </div>
            {% endif %}
        {% endif %}
    {% endblock %}

</div>
{% endblock %}