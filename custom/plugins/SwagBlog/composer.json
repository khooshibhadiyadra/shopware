{
    "name": "swag-blog/swag-blog",
    "description": "swag-blog/swag-blog",
    "type": "shopware-platform-plugin",
    "version": "1.0.0",
    "license": "MIT",
    "require": {
        "shopware/core": "~6.6.0"
    },
    "extra": {
        "shopware-plugin-class": "SwagBlog\\SwagBlog",
        "label": {
            "de-DE": "Skeleton plugin blog",
            "en-GB": "Skeleton plugin blog"
        }
    },
    "autoload": {
        "psr-4": {
            "SwagBlog\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SwagBlog\\Tests\\": "tests/"
        }
    }
}
