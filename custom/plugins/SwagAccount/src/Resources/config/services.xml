<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="SwagAccount\Storefront\Controller\ExampleController" public="true">
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>

        <service id="SwagAccount\Core\Content\Example\SalesChannel\ExampleRoute">
            <argument type="service" id="product.repository"/>
        </service>

        <service id="SwagAccount\Core\Content\Example\SalesChannel\SwagAccountDefinition">
            <tag name="shopware.entity.definition" entity="swag_account" />
        </service>

        <service id="SwagAccount\Core\Content\Example\SalesChannel\SwagAccount\Aggregate\SwagAccountTranslationDefinition">
            <tag name="shopware.entity.definition" entity="swag_account_translation" />
        </service>

        <service id="SwagAccount\Core\Content\Extension\CountryExtension">
            <tag name="shopware.entity.extension" />
        </service>

        <service id="SwagAccount\Core\Content\Extension\CountryStateExtension">
            <tag name="shopware.entity.extension" />
        </service>

        <service id="SwagAccount\Core\Content\Extension\LanguageExtension">
            <tag name="shopware.entity.extension" />
        </service>

        <service id="SwagAccount\Core\Content\Extension\MediaExtension">
            <tag name="shopware.entity.extension" />
        </service>

        <service id="SwagAccount\Core\Content\Extension\ProductExtension">
            <tag name="shopware.entity.extension" />
        </service>
    </services>
</container>