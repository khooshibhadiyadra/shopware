<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="BlogTask\Core\Content\Blog\BlogDefinition">
            <tag name="shopware.entity.definition" entity="blog" />
        </service>

        <service id="BlogTask\Core\Content\BlogCategory\BlogCategoryDefinition">
            <tag name="shopware.entity.definition" entity="blog_category" />
        </service>

        <service id="BlogTask\Core\Content\BlogCategoryMapping\BlogCategoryMappingDefinition">
            <tag name="shopware.entity.definition" entity="blog_category_blog" />
        </service>

        <service id="BlogTask\Core\Content\BlogProductMapping\BlogProductMappingDefinition">
            <tag name="shopware.entity.definition" entity="blog_product" />
        </service>

        <service id="BlogTask\Core\Content\Blog\Aggregate\BlogTranslationDefinition">
            <tag name="shopware.entity.definition" entity="blog_translation" />
        </service>

        <service id="BlogTask\Core\Content\BlogCategory\Aggregate\BlogCategoryTranslationDefinition">
            <tag name="shopware.entity.definition" entity="blog_category_translation" />
        </service>

        <service id="BlogTask\Core\Content\Extension\LanguageExtension">
            <tag name="shopware.entity.extension" />
        </service>

        <service id="BlogTask\Core\Content\Extension\ProductExtension">
            <tag name="shopware.entity.extension" />
        </service>

<!--        <service id="BlogTask\Core\Controllers\Storefront\ExampleController" public="true">-->
<!--            <argument type="service" id="blog.repository"/>-->
<!--            <call method="setContainer">-->
<!--                <argument type="service" id="service_container"/>-->
<!--            </call>-->
<!--            <call method="setTwig">-->
<!--                <argument type="service" id="twig"/>-->
<!--            </call>-->
<!--        </service>-->
        <service id="BlogTask\Core\Controllers\Storefront\ExampleController" public="true">
            <argument type="service" id="blog.repository"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
            <call method="setTwig">
                <argument type="service" id="twig"/>
            </call>
        </service>
        <service id="BlogTask\Core\Controllers\Api\BlogController" public="true">
            <argument type="service" id="blog.repository" />
            <argument type="service" id="blog_category.repository"/>
            <tag name="controller.service_arguments"/>
            <call method="setContainer">
                <argument id="service_container" type="service" />
            </call>
        </service>
    </services>
</container>
