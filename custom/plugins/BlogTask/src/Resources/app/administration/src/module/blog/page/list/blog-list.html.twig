<sw-page>
    <template #search-bar>
        <sw-search-bar
                :initial-search="term"
                @search="onSearch"
        ></sw-search-bar>
    </template>

    <template #smart-bar-header>
        <h2>{{ $tc('blog.list.title') }}</h2>
    </template>

    <template #language-switch>
        <sw-language-switch @on-change="onChangeLanguage"></sw-language-switch>
    </template>

    <template #smart-bar-actions>
        <sw-button @click="onCreateNewBlog" variant="primary">
            {{ $tc('blog.general.createButton') }}
        </sw-button>
    </template>

    <template #content>
        <sw-entity-listing
                detail-route="blog.module.detail"
                :is-loading="isLoading"
                :columns="blogColumns"
                :repository="blogRepository"
                :items="blogs"
        >
            <template #column-categories="{ item }">
        <span>
{#            {{ item.blogCategories.map(category=>category.name).join(', ') }}#}
{#            {{ item.categories.map(category=>blogCategory.name).join(', ') }}#}
            {{ item.categories.map(category=>category.name).join(', ') }}
        </span>
            </template>
            <template #column-products="{ item }">
        <span>
            {{ item.products.map(product => product.name).join(', ') }}
        </span>
            </template>
            <template #column-description="{ item }">
                <span v-html="item.description"></span>
            </template>
        </sw-entity-listing>
    </template>
</sw-page>