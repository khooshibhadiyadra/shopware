{% block sw_blog_detail %}
    <sw-page class="sw-blog-detail">
        {% block sw_product_list_language_switch %}
            <template #language-switch>
                <sw-language-switch
                        :disabled="blogId == null || undefined"
                        :save-changes-function="saveOnLanguageChange"
                        :abort-change-function="abortOnLanguageChange"
                        @on-change="onChangeLanguage"
                />
            </template>
        {% endblock %}
        <template #smart-bar-actions>
            <sw-button :router-link="{name: 'sw.blog.index'}">
                {{$tc('cancel')}}
            </sw-button>
            <sw-button-process :isloading="isLoading" :processsuccess="processSuccess" variant="primary" @process-finish="saveFinish" @click="onClickSave">
                {{$tc('save')}}
            </sw-button-process>
        </template>
        <template #content>
            <sw-card-view>
                <sw-card v-if="blog">
                    <sw-text-field
                            v-model:value="blog.name"
                            :placeholder="$tc('Name')"
                            :label="$tc('Name')"
                            name="name"
                            validation="required"
                            required
                            :error="blogCategoryNameError"
                    />
                    <sw-textarea-field
                            v-model:value="blog.description"
                            :placeholder="$tc('description')"
                            :label="$tc('Description')"
                            name="name"
                            validation="required"
                    >
                    </sw-textarea-field>
                    <sw-text-field
                            v-model:value="blog.author"
                            :placeholder="$tc('Author')"
                            :label="$tc('Author')"
                            name="author"
                            validation="required"
                    />
                    <sw-datepicker
                            v-model:value="blog.releaseDate"
                            :label="$tc('Release date')"
                            name="release_date"
                    >
                    </sw-datepicker>

                    <sw-switch-field
                            :label="$tc('Status')"
                            v-model:value="blog.active"
                            name="active"
                    />
                    <sw-entity-multi-select
                            :label="$tc('Category')"
                            :placeholder="$tc('Category')"
                            entity-name="blog_category"
                            v-model:entityCollection="blog.blogCategories"
                    >
                    </sw-entity-multi-select>
                    <sw-entity-multi-select
                            :label="$tc('Product')"
                            :placeholder="$tc('Product')"
                            entity-name="product"
                            v-model:entityCollection="blog.products"
                    >
                    </sw-entity-multi-select>
                </sw-card>
            </sw-card-view>
        </template>
    </sw-page>
{% endblock %}