{% sw_extends '@Storefront/storefront/base.html.twig' %}

{% block base_content %}
    <h2>Blog controller!</h2>
{#    {{ dump('test') }}#}
    <h4>{{example}}</h4>
{#    {{ dump(blogs) }}#}
    {% for blog in blogs %}
        <div class="container rounded mb-4 p-3 border rounded">
            <div class="blog-entry">
                <h3>Blog name: {{ blog.name }}</h3>
                <h5>Description: {{ blog.description }}</h5><br>
                <h5>Release Date: {{ blog.releaseDate|date('d-m-Y') }}</h5><br>
                <h5>Author: {{ blog.author }}</h5><br>
                <h5>Status: {{ blog.active ? 'Active' : 'Inactive' }}</h5><br><br>
            </div>
        </div>
    {% else %}
        <p>no blogs found.</p>
    {% endfor %}
{% endblock %}